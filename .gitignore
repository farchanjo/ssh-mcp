# Generated files
/target/
**/*.rs.bk
Cargo.lock

# Environment variables
.env
.env.local
.env.*

# SSH keys
ssh_host_key
*.pem
*.key
*.pub
privkey

# Python cache
__pycache__/
**/__pycache__/
*.pyc

# Pytest cache (every depth — top-level, scripts/*, helpers/*)
.pytest_cache/
**/.pytest_cache/

# Logs
*.log

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code local state (per-machine, never committed)
.claude/
.venv/

# v7.1+ CI: .github/workflows must live on GitHub for Actions to run it.
# (Older policy kept .github/ local-only; obsolete since the self-hosted
# runner pipeline landed.) Local-only GitHub bits can still be ignored below.
!.github/

# Local script caches (mypy / ruff / coverage / tox when invoked under scripts/)
scripts/.cache/
scripts/.mypy_cache/
scripts/.ruff_cache/
scripts/.tox/
scripts/.coverage
scripts/htmlcov/

# v5 Phase 5 — soak / stress harness output
scripts/soak_metrics.csv